<!-- Site-wide stats from KV -->
<script>
  (function() {
    fetch('/api/stats')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var el = document.getElementById('site-total-views');
        if (el && data.total_views !== undefined) {
          el.textContent = data.total_views >= 1000
            ? (data.total_views / 1000).toFixed(1) + 'k'
            : data.total_views;
        }
      })
      .catch(function(e) { console.warn('Stats API unavailable', e); });
  })();
</script>

