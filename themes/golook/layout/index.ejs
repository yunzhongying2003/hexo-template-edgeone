<div class="home-posts">
  <% if (page.posts.length > 0) { %>
    <% page.posts.each(function(post) { %>
      <article class="post-item">
        <div class="post-content-wrapper">
          <% if (post.cover || post.photos && post.photos.length > 0) { %>
            <div class="post-cover">
              <img src="<%= post.cover || post.photos[0] %>" alt="<%= post.title %>" style="width: 120px; height: auto; object-fit: cover;">
            </div>
          <% } %>
          
          <div class="post-details">
            <h2 class="post-title">
              <a href="<%= post.permalink %>"><%- post.title %></a>
            </h2>
            
            <div class="post-meta">
              <span class="post-date">
                <%= moment(post.date).format('YYYY-MM-DD') %>
              </span>
              
              <% if (post.tags && post.tags.length > 0) { %>
                <div class="post-tags">
                  <% post.tags.forEach(function(tag) { %>
                    <a href="<%= tag.path %>" class="tag-link"><%- tag.name %></a>
                  <% }); %>
                </div>
              <% } %>
            </div>
            
            <div class="post-excerpt">
              <% 
                var excerpt = post.excerpt;
                if (!excerpt) {
                  // 尝试从 content 中提取纯文本摘要
                  var content = post.content || '';
                  // 移除 HTML 标签
                  var plainText = content.replace(/<[^>]+>/g, '');
                  // 截取前 200 个字符
                  excerpt = plainText.slice(0, 200);
                  // 如果截断处不是单词结尾，尽量回退到空格处
                  if (plainText.length > 200) {
                    var lastSpace = excerpt.lastIndexOf(' ');
                    if (lastSpace > -1) {
                      excerpt = excerpt.slice(0, lastSpace) + '...';
                    } else {
                      excerpt += '...';
                    }
                  }
                }
              %>
              <p><%- excerpt %></p>
            </div>
          </div>
        </div>
        
        <hr class="post-divider">
      </article>
    <% }); %>
    
    <div class="pagination">
      <%- paginator({
        prev_text: '上一页',
        next_text: '下一页',
        format: '%d'
      }) %>
    </div>
  <% } else { %>
    <div class="no-posts">
      <p>暂无文章</p>
    </div>
  <% } %>
</div>
