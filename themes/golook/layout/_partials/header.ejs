<header class="site-header">
  <nav class="site-nav">
    <!-- 左侧：网站名 -->
    <div class="site-brand">
      <a href="<%= url_for('/') %>" class="site-logo"><%= config.title %></a>
    </div>

    <!-- 菜单：桌面 -->
    <div class="nav-menu" id="navMenu">
      <%- Object.entries(theme.menu || {}).map(([label, path]) => '<a href="' + url_for(path) + '"' + (is_current(path) ? ' class="active"' : '') + '>' + label + '</a>').join('') %>
    </div>

    <!-- 右侧：暗色模式切换 + 汉堡菜单 -->
    <div class="nav-actions">
      <!-- 暗色模式切换按钮 -->
      <button class="theme-toggle" id="theme-toggle" aria-label="切换暗色模式"></button>

      <!-- 移动端汉堡菜单按钮 -->
      <button class="menu-toggle" id="menuToggle" onclick="toggleMenu()" aria-label="打开菜单">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // 移动端菜单切换
  function toggleMenu() {
    const menu = document.getElementById('navMenu')
    menu.classList.toggle('nav-menu--open')
  }
</script>