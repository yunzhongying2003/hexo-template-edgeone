<div class="archive-page">
  <h1 class="page-title">归档</h1>

  <% if (page.posts.length > 0) { %>
    <div class="archive-content">
      <% var years = {}; %>
      <% page.posts.each(function(post) { %>
        <% var year = post.date.format('YYYY'); %>
        <% if (!years[year]) years[year] = []; %>
        <% years[year].push(post); %>
      <% }); %>
      <% var sortedYears = Object.keys(years).sort(function(a, b) { return b - a; }); %>
      <% sortedYears.forEach(function(year) { %>
        <h2 class="archive-year"><%= year %></h2>
        <ul class="archive-list">
          <% years[year].forEach(function(post) { %>
            <li class="archive-item">
              <span class="archive-date"><%= post.date.format('YYYY-MM-DD') %></span>
              <a href="<%= post.path %>" class="archive-title"><%= post.title %></a>
            </li>
          <% }); %>
        </ul>
      <% }); %>
    </div>
  <% } else { %>
    <div class="archive-empty">
      <p>暂无归档</p>
    </div>
  <% } %>
</div>