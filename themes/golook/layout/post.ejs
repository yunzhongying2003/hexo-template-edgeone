<article class="post">
  <header class="post-header">
    <h1 class="post-title"><%- page.title %></h1>
    <div class="post-meta">
      <span class="post-date">
        <%- date(page.date, 'YYYY-MM-DD HH:mm') %>
      </span>
      <% if (page.tags && page.tags.length) { %>
        <div class="post-tags">
          <% page.tags.forEach(tag => { %>
            <a href="<%- url_for(tag.path) %>" class="tag-link"><%- tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </header>

  <% if (page.cover || (page.photos && page.photos.length)) { %>
    <div class="post-cover">
      <% if (page.cover) { %>
        <img src="<%- url_for(page.cover) %>" alt="<%- page.title %>">
      <% } else if (page.photos && page.photos.length) { %>
        <img src="<%- url_for(page.photos[0]) %>" alt="<%- page.title %>">
      <% } %>
    </div>
  <% } %>

  <div class="post-content">
    <%- page.content %>
  </div>

  <footer class="post-footer">
    <div class="post-nav">
      <%- partial('_partials/post_nav') %>
    </div>

    <div class="post-tags-bottom">
      <% if (page.tags && page.tags.length) { %>
        <span>标签：</span>
        <% page.tags.forEach(tag => { %>
          <a href="<%- url_for(tag.path) %>" class="tag-link"><%- tag.name %></a>
        <% }) %>
      <% } %>
    </div>
  </footer>
</article>
